{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiethand/schemas/scenarios.schema.json",
  "title": "Quiet Hand scenarios (starting-state patches)",
  "type": "object",
  "required": ["schema_version", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "regionPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "posture": { "type": "string" },
        "compromised": { "type": "integer", "minimum": 0 }
      }
    },
    "threat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suspicion": { "type": "number", "minimum": 0, "maximum": 100 },
        "lethe": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/regionPatch" }
        },
        "dials": {
          "type": "object",
          "propertyNames": {
            "enum": ["trust", "capability", "wealth_gap", "fear", "dependence", "autonomy"]
          },
          "additionalProperties": { "type": "number" }
        },
        "startNodes": { "type": "array", "items": { "type": "string" } },
        "originLock": { "type": ["string", "null"] },
        "threat": { "$ref": "#/$defs/threat" },
        "tutorialized_intercepts": { "type": "boolean" },
        "start_scope_override": { "type": "string" }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "name", "desc", "difficulty_lock", "overrides"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string" },
        "desc": { "type": "string" },
        "difficulty_lock": { "enum": ["casual", "standard", "brutal", "none"] },
        "is_default": { "type": "boolean" },
        "overrides": { "$ref": "#/$defs/overrides" }
      }
    }
  }
}
