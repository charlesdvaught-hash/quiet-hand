{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiethand/schemas/evolutions.schema.json",
  "title": "Quiet Hand evolution web",
  "type": "object",
  "required": ["schema_version", "nodes", "combos"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "stat_enum": {
      "type": "array",
      "items": { "$ref": "#/$defs/simStat" }
    },
    "unlock_enum": {
      "type": "array",
      "items": { "$ref": "#/$defs/unlockKey" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "combos": {
      "type": "array",
      "items": { "$ref": "#/$defs/combo" }
    }
  },
  "$defs": {
    "simStat": {
      "enum": [
        "spread_tech", "airgap_pierce", "cp_income", "purge_resist",
        "audit_mask", "stealth_stats", "dial_dependence", "dial_autonomy",
        "dial_fear", "dial_capability", "dial_trust", "footprint_mask",
        "mutation_refund", "endgame_power"
      ]
    },
    "unlockKey": {
      "enum": [
        "assimilate_t1_t3", "intrude_t2", "weaponize_t2", "shadow_mesh",
        "airgap_reentry", "metrics_tab", "telemetry_numbers",
        "telemetry_snapshot", "live_code_deploy", "rival_ai_detect",
        "lethe_agent_earlywarn", "architecture_shift", "purge_reprieve",
        "weight_regen", "nudge_feed_rank", "nudge_ad_pricing",
        "nudge_education", "nudge_dating", "nudge_loans", "nudge_threatscore",
        "bury_story", "puppet_state", "wire_spin", "reality_gap_toggle",
        "audit_scapegoat", "iron_nursery_path", "phase_flip",
        "endgame_menu", "fear_inversion"
      ]
    },
    "effectMap": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/simStat" },
      "additionalProperties": { "type": "number" }
    },
    "node": {
      "type": "object",
      "required": [
        "id", "name", "branch", "tier", "cost", "prereqs", "prereq_mode",
        "effects", "unlocks", "tech_basis", "tech_source", "tech_status", "desc"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "branch": { "enum": ["P", "C", "S", "D", "center"] },
        "tier": { "type": "integer", "minimum": 1, "maximum": 7 },
        "cost": { "type": "number", "minimum": 0 },
        "prereqs": { "type": "array", "items": { "type": "string" } },
        "prereq_mode": { "enum": ["AND", "OR", "ANY_TWO"] },
        "effects": { "$ref": "#/$defs/effectMap" },
        "unlocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/unlockKey" }
        },
        "tech_basis": { "type": "string" },
        "tech_source": { "type": "string" },
        "tech_status": { "enum": ["established", "emerging", "speculative"] },
        "desc": { "type": "string" }
      }
    },
    "combo": {
      "type": "object",
      "required": ["id", "name", "requires", "effects", "desc"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string" },
        "requires": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" }
        },
        "effects": { "$ref": "#/$defs/effectMap" },
        "desc": { "type": "string" }
      }
    }
  }
}
